{
  "manifest_version": 3,
  "name": "PhishVigil",
  "version": "0.1.0",
  "description": "Client-side phishing detection with ONNX-powered ML",
  "permissions": [
    "webNavigation",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["model/*.onnx", "model/*.wasm"],
      "matches": ["<all_urls>"]
    }
  ]
}